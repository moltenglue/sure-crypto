<div id="rotki-providers-panel" class="space-y-4">
  <div class="prose prose-sm text-secondary">
    <p class="text-primary font-medium"><%= t("settings.providers.rotki_panel.setup_instructions") %></p>
    <ol>
      <li><%= t("settings.providers.rotki_panel.step1_html").html_safe %></li>
      <li><%= t("settings.providers.rotki_panel.step2") %></li>
      <li><%= t("settings.providers.rotki_panel.step3") %></li>
    </ol>
  </div>

  <% error_msg = local_assigns[:error_message] || @error_message %>
  <% if error_msg.present? %>
    <div class="p-2 rounded-md bg-destructive/10 text-destructive text-sm overflow-hidden">
      <p class="line-clamp-3" title="<%= error_msg %>"><%= error_msg %></p>
    </div>
  <% end %>

  <% if Current.user.rotki_encrypted_password.present? %>
    <div class="flex items-center justify-between p-3 bg-container-inset rounded-lg border border-primary">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-[#194ef0] flex items-center justify-center">
          <%= icon "bitcoin", size: "md", class: "text-white" %>
        </div>
        <div>
          <p class="font-medium text-primary">Rotki</p>
          <p class="text-xs text-secondary">
            <%= t("settings.providers.rotki_panel.connected") %>
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <%= button_to "/api/v1/rotki/disconnect",
                      method: :post,
                      class: "inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-destructive hover:bg-destructive/10 rounded-lg",
                      data: { turbo_confirm: t("settings.providers.rotki_panel.disconnect_confirm") } do %>
          <%= icon "trash-2", size: "sm" %>
          <%= t("settings.providers.rotki_panel.disconnect") %>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= styled_form_with url: "/api/v1/rotki/connect",
                         method: :post,
                         data: { turbo: true },
                         class: "space-y-3" do |form| %>
      <%= form.text_field :password,
                          label: t("settings.providers.rotki_panel.password_label"),
                          placeholder: t("settings.providers.rotki_panel.password_placeholder"),
                          type: :password %>

      <div class="flex justify-end">
        <%= form.submit t("settings.providers.rotki_panel.connect_button"),
                        class: "inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-medium text-inverse bg-inverse hover:bg-inverse-hover focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 transition-colors" %>
      </div>
    <% end %>
  <% end %>

  <div class="flex items-center gap-2">
    <% if Current.user.rotki_encrypted_password.present? %>
      <div class="w-2 h-2 bg-success rounded-full"></div>
      <p class="text-sm text-secondary"><%= t("settings.providers.rotki_panel.status_connected") %></p>
    <% else %>
      <div class="w-2 h-2 bg-tertiary rounded-full"></div>
      <p class="text-sm text-secondary"><%= t("settings.providers.rotki_panel.status_not_connected") %></p>
    <% end %>
  </div>
</div>
